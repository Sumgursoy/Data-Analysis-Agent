# Bu dosyayı ".env" olarak kopyala ve kendi değerlerini yaz.
# .env dosyası .gitignore'da — asla commit etme.

# ─────────────────────────────────────────────────────────────
#  LLM
# ─────────────────────────────────────────────────────────────

OPENAI_API_KEY=sk-...

# Model. Boş bırakırsan config.py'daki varsayılan kullanılır.
# OPENAI_MODEL=gpt-5.6-terra

# Hangi API arayüzü konuşulacak:
#   responses → /v1/responses         (OpenAI'a özel)
#   chat      → /v1/chat/completions  (evrensel; Ollama, vLLM, OpenRouter…)
#
# Boş bırak: OpenAI'da otomatik "responses", LLM_BASE_URL doluysa "chat".
#
# NEDEN responses: gpt-5.6 ailesi chat ucunda function tool ile akıl
# yürütmeyi BİRLİKTE kabul etmiyor (HTTP 400). Chat kullanmak için
# reasoning_effort='none' gerekiyor — kod yazıp hatasını düzelten bir
# agent için ciddi kalite kaybı. Ölçümde responses daha az token da yaktı.
# LLM_BACKEND=

# Sadece chat backend'i için; açık modeller bunu yok sayar.
# CHAT_REASONING_EFFORT=none

# Farklı bir sunucuya bağlanmak için. Boş = OpenAI.
# Örnekler:
#   Ollama (yerel)  → http://localhost:11434/v1
#   LM Studio       → http://localhost:1234/v1
#   vLLM            → http://localhost:8000/v1
#   OpenRouter      → https://openrouter.ai/api/v1
# LLM_BASE_URL=

# ─────────────────────────────────────────────────────────────
#  Sandbox
# ─────────────────────────────────────────────────────────────

# docker → izole container (varsayılan, önerilen)
# local  → subprocess fallback. Docker çalışmazsa demo günü buna düş.
# SANDBOX_BACKEND=docker
